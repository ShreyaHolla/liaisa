<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= businessName %> · Owner</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main class="wide" id="dash" data-sig="<%= JSON.stringify(summary.needsYou) %>">
    <header class="top">
      <p class="brand"><%= businessName %></p>
      <nav class="top-nav" aria-label="Owner">
        <a href="/owner/clients">Client Finder</a>
        <a href="/owner/setup">Business setup</a>
        <form method="post" action="/owner/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn text" type="submit">Log out</button>
        </form>
      </nav>
    </header>
    <h1>Hello, <%= businessName %></h1>
    <% if (notice) { %>
      <p class="banner tone-<%= notice[0] === 'ok' ? 'done' : 'problem' %>" role="<%= notice[0] === 'ok' ? 'status' : 'alert' %>"><%= notice[1] %></p>
    <% } %>

    <section class="section" aria-labelledby="needs-h">
      <h2 id="needs-h">Needs you (<%= summary.needsYou.length %>)</h2>
      <div class="panel">
        <% if (summary.needsYou.length === 0) { %>
          <p class="slate">Nothing needs you right now. New enquiries will appear here.</p>
        <% } else { %>
          <ul class="rows">
            <% summary.needsYou.forEach(function (n) { %>
              <li>
                <span class="grow"><strong><%= n.customerName %></strong>
                  <% if (n.what) { %><span class="what"> · <%= n.what %></span><% } %></span>
                <span class="badge <%= n.kind === 'send_failed' ? 'tone-problem' : 'tone-needs' %>"><%= n.label %></span>
                <% if (n.total !== undefined) { %><span><%= inr(n.total) %></span><% } %>
                <a class="btn secondary" href="/owner/enquiries/<%= n.enquiryId %>"><%= n.kind === 'customer_question' ? 'Reply' : n.kind === 'send_failed' ? 'Retry sending' : 'Review' %><span class="sr"> for <%= n.customerName %></span></a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <p class="slate small">This week: <%= summary.week.enquiries %> enquiries · <%= summary.week.quotesSent %> quotes sent · <%= summary.week.accepted %> accepted</p>

    <section class="section" aria-labelledby="fu-h">
      <h2 id="fu-h">Follow-up due (<%= summary.followUps.length %>)</h2>
      <div class="panel">
        <% if (summary.followUps.length === 0) { %>
          <p class="slate">No sent quotes are waiting for a reminder.</p>
        <% } else { %>
          <ul class="rows">
            <% summary.followUps.forEach(function (f) { %>
              <li>
                <span class="grow"><strong><%= f.customerName %></strong>
                  <% if (f.what) { %><span class="what"> · <%= f.what %></span><% } %></span>
                <span class="slate small"><%= f.quoteAge %> · <%= f.remindersSent %> of 2 reminders sent</span>
                <a class="btn secondary" href="/owner/enquiries/<%= f.enquiryId %>">Follow up<span class="sr"> with <%= f.customerName %></span></a>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    </section>

    <section class="section" aria-labelledby="all-h">
      <h2 id="all-h">All enquiries</h2>
      <% if (summary.all.length === 0) { %>
        <p class="slate">No enquiries yet. Share your enquiry link: <a href="/enquire"><%= baseUrl.replace(/\/$/, '') %>/enquire</a></p>
      <% } else { %>
        <table class="list">
          <thead><tr><th scope="col">Name</th><th scope="col">What</th><th scope="col">Status</th><th scope="col">Updated</th></tr></thead>
          <tbody>
            <% summary.all.forEach(function (e) { %>
              <tr>
                <td><a href="/owner/enquiries/<%= e.id %>"><%= e.name %></a></td>
                <td><%= e.what %></td>
                <td><span class="badge tone-<%= e.tone %>"><%= e.label %></span></td>
                <td><%= e.updated %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </section>
  </main>
  <script src="/js/owner.js" defer></script>
</body>
</html>
