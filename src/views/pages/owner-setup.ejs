<%
  var fe = function (key) { return errors[key] ? '<p class="field-error" id="err-' + key.replace(/\./g, '-') + '">' + errors[key].replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</p>' : ''; };
  var bad = function (key) { return errors[key] ? ' aria-invalid="true" aria-describedby="err-' + key.replace(/\./g, '-') + '"' : ''; };
%>
<%- include('../partials/head', { title: 'Business setup · ' + businessName }) %>
<%- include('../partials/owner-open', { active: 'setup', businessName: businessName, csrfToken: csrfToken, pending: pending }) %>
<div class="setup">
  <div class="page-head"><h1>Business setup</h1></div>
  <p class="slate">Changes apply to new enquiries. Quotes already made keep the numbers they were priced with.</p>
  <% if (notice) { %><p class="banner tone-done" role="status"><%= notice[1] %></p><% } %>
  <% if (Object.keys(errors).length) { %><p class="banner tone-problem" role="alert">Some details need another look. They are marked below.</p><% } %>
  <% if (errors._form) { %><p class="banner tone-problem" role="alert"><%= errors._form %></p><% } %>
  <% if (onboarding) { %>
    <section class="card" aria-labelledby="start-h">
      <h2 id="start-h">Welcome. Two things to do first</h2>
      <ol class="small">
        <li><strong>Set your prices.</strong> Replace the two example services and two areas below with your own, then save.</li>
        <li><strong>Share your link.</strong> Copy it, send it on WhatsApp or print the QR code below.</li>
      </ol>
    </section>
  <% } %>
  <%- include('../partials/share-card', { share: share, prominent: noEnquiries }) %>

  <section class="card" aria-labelledby="usage-h">
    <h2 id="usage-h">AI use today</h2>
    <% if (!usage.aiOn) { %><p class="small">AI is switched off, so customers fill in the form instead.</p><% } %>
    <ul class="small">
      <li>AI requests: <%= usage.requests %> of <%= usage.requestLimit %></li>
      <li>Message drafts: <%= usage.drafts %> of <%= usage.draftLimit %></li>
      <li>Searches for clients: <%= usage.runs %> of <%= usage.runLimit %> (<%= usage.searches %> web searches)</li>
    </ul>
    <p class="small slate">When a limit is reached, enquiries switch to the simple form and everything keeps working. Limits reset each day.</p>
  </section>

  <form method="post" action="/owner/setup" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <fieldset class="card">
      <legend>Your business</legend>
      <div class="field">
        <label for="businessName">Business name</label>
        <input id="businessName" name="businessName" type="text" maxlength="120" required value="<%= v.businessName %>"<%- bad('businessName') %>>
        <%- fe('businessName') %>
      </div>
      <div class="field">
        <label for="tagline">Tagline (optional)</label>
        <input id="tagline" name="tagline" type="text" maxlength="200" value="<%= v.tagline %>"<%- bad('tagline') %>>
        <%- fe('tagline') %>
      </div>
      <div class="field">
        <label for="currencySymbol">Currency symbol (display only)</label>
        <input id="currencySymbol" name="currencySymbol" type="text" maxlength="3" value="<%= v.currencySymbol %>"<%- bad('currencySymbol') %>>
        <%- fe('currencySymbol') %>
      </div>
      <div class="field">
        <label for="city">City (used to keep searches for clients local)</label>
        <input id="city" name="city" type="text" maxlength="80" value="<%= v.city %>"<%- bad('city') %>>
        <%- fe('city') %>
      </div>
      <div class="field">
        <label for="whatsappNumber">WhatsApp number (optional)</label>
        <input id="whatsappNumber" name="whatsappNumber" type="tel" maxlength="30" value="<%= v.whatsappNumber %>"<%- bad('whatsappNumber') %>>
        <%- fe('whatsappNumber') %>
      </div>
    </fieldset>

    <fieldset class="card">
      <legend>Services (up to <%= limits.services %>)</legend>
      <% v.services.forEach(function (s, i) { %>
        <div class="rowcard svc">
          <input type="hidden" name="svcId" value="<%= s.id %>">
          <div class="field wide2">
            <label for="svcName<%= i %>">Name</label>
            <input id="svcName<%= i %>" name="svcName" type="text" maxlength="80" value="<%= s.name %>"<%- bad('services.' + i + '.name') %>>
            <%- fe('services.' + i + '.name') %>
          </div>
          <div class="field">
            <label for="svcPrice<%= i %>">Price per unit (<%= v.currencySymbol %>)</label>
            <input id="svcPrice<%= i %>" name="svcPrice" type="number" min="0" step="1" inputmode="numeric" value="<%= s.price %>"<%- bad('services.' + i + '.price') %>>
            <%- fe('services.' + i + '.price') %>
          </div>
          <div class="field">
            <label for="svcMin<%= i %>">Minimum</label>
            <input id="svcMin<%= i %>" name="svcMin" type="number" min="1" step="1" inputmode="numeric" value="<%= s.minQty %>"<%- bad('services.' + i + '.minQty') %>>
            <%- fe('services.' + i + '.minQty') %>
          </div>
          <div class="field">
            <label for="svcMax<%= i %>">Maximum (optional)</label>
            <input id="svcMax<%= i %>" name="svcMax" type="number" min="1" step="1" inputmode="numeric" value="<%= s.maxQty %>"<%- bad('services.' + i + '.maxQty') %>>
            <%- fe('services.' + i + '.maxQty') %>
          </div>
          <div class="field wide2">
            <label for="svcUnit<%= i %>">Unit label</label>
            <input id="svcUnit<%= i %>" name="svcUnit" type="text" maxlength="40" value="<%= s.unitLabel %>"<%- bad('services.' + i + '.unitLabel') %>>
            <%- fe('services.' + i + '.unitLabel') %>
          </div>
          <label class="remove"><input type="checkbox" name="svcRemove" value="<%= i %>"> Remove<span class="sr"> service <%= i + 1 %></span></label>
        </div>
      <% }) %>
      <%- fe('services') %>
      <p class="slate small">Empty rows are ignored. Fill one in to add a service. Renaming keeps a service’s history.</p>
    </fieldset>

    <fieldset class="card">
      <legend>Areas and travel fees (up to <%= limits.areas %>)</legend>
      <% v.areas.forEach(function (a, i) { %>
        <div class="rowcard area">
          <div class="field">
            <label for="areaName<%= i %>">Area</label>
            <input id="areaName<%= i %>" name="areaName" type="text" maxlength="60" value="<%= a.name %>"<%- bad('areas.' + i + '.name') %>>
            <%- fe('areas.' + i + '.name') %>
          </div>
          <div class="field">
            <label for="areaFee<%= i %>">Travel fee (<%= v.currencySymbol %>)</label>
            <input id="areaFee<%= i %>" name="areaFee" type="number" min="0" step="1" inputmode="numeric" value="<%= a.fee %>"<%- bad('areas.' + i + '.fee') %>>
            <%- fe('areas.' + i + '.fee') %>
          </div>
          <label class="remove"><input type="checkbox" name="areaRemove" value="<%= i %>"> Remove<span class="sr"> area <%= i + 1 %></span></label>
        </div>
      <% }) %>
      <%- fe('areas') %>
    </fieldset>

    <fieldset class="card">
      <legend>Surcharge and tax</legend>
      <div class="field">
        <label for="weekendPct">Weekend surcharge (%)</label>
        <input id="weekendPct" name="weekendPct" type="number" min="0" max="100" step="any" inputmode="decimal" value="<%= v.weekendPct %>"<%- bad('weekendPct') %>>
        <%- fe('weekendPct') %>
      </div>
      <div class="field">
        <label for="taxPct">Tax (%)</label>
        <input id="taxPct" name="taxPct" type="number" min="0" max="100" step="any" inputmode="decimal" value="<%= v.taxPct %>"<%- bad('taxPct') %>>
        <%- fe('taxPct') %>
      </div>
    </fieldset>

    <fieldset class="card" id="bulk">
      <legend>Approvals</legend>
      <div class="field">
        <label for="bulkApproveLimit">Biggest total for a clean quote (<%= v.currencySymbol %>, optional)</label>
        <input id="bulkApproveLimit" name="bulkApproveLimit" type="number" min="1" step="1" inputmode="numeric" value="<%= v.bulkApproveLimit %>"<%- bad('bulkApproveLimit') %>>
        <%- fe('bulkApproveLimit') %>
        <p class="slate small">A clean quote has no warnings and a total up to this amount. It powers “Approve all clean quotes” on Approvals. Leave it empty to switch that off.</p>
      </div>
      <div class="field">
        <label class="check" for="autoApprove"><input id="autoApprove" name="autoApprove" type="checkbox" value="on"<%= v.autoApprove ? ' checked' : '' %><%- bad('autoApprove') %>> Send clean quotes without asking me</label>
        <%- fe('autoApprove') %>
        <p class="slate small">Off by default. Only for email customers, only clean quotes within your limit, and never a quote with a warning. Each one is logged in Activity as sent automatically.</p>
      </div>
    </fieldset>

    <fieldset class="card" id="followups">
      <legend>Follow-ups</legend>
      <div class="field">
        <label for="followupAfterDays">Remind me to follow up after (days)</label>
        <input id="followupAfterDays" name="followupAfterDays" type="number" min="0" max="60" step="1" inputmode="numeric" value="<%= v.followupAfterDays %>"<%- bad('followupAfterDays') %>>
        <%- fe('followupAfterDays') %>
        <p class="slate small">A sent quote with no reply appears under “Follow-up due” after this many days. Use 0 to see it straight away, for a demo.</p>
      </div>
    </fieldset>

    <div class="action-bar action-bar--sticky">
      <button class="btn lg" type="submit">Save changes</button>
    </div>
  </form>

  <form method="post" action="/owner/setup/reset" class="section">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn danger-text" type="submit"
      <% if (isDemo) { %>data-confirm="Reset to the demo business? Your name, services, areas and fees will be replaced with the Mehfil Kitchen defaults. Quotes already made keep their numbers."
      data-confirm-label="Reset to demo business">Reset to demo business</button>
      <% } else { %>data-confirm="Reset the services and areas to the starter examples? Your business name and details stay. Quotes already made keep their numbers."
      data-confirm-label="Reset to starter prices">Reset to starter prices</button><% } %>
  </form>
</div>
<%- include('../partials/owner-close', { scripts: ['/js/share.js'] }) %>
