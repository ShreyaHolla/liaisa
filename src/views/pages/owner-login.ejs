<%- include('../partials/head', { title: 'Log in · Liaisa' }) %>
<body>
  <%- include('../partials/site-bar', { brand: 'Liaisa', links: false }) %>
  <main class="container container--narrow">
    <h1>Log in</h1>
    <% if (error) { %><p class="banner tone-problem" role="alert"><%= error %></p><% } %>
    <form method="post" action="/owner/login" class="card">
      <p class="tag-row"><span class="tag">Form</span> Your email and password.</p>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" maxlength="254" required autofocus>
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required>
      </div>
      <button class="btn lg block" type="submit">Log in</button>
    </form>
    <p class="small">New here? <a href="/signup">Sign up your business</a> · <a href="/">← Back to Liaisa</a></p>
    <%- include('../partials/legend') %>
  </main>
  <script src="<%= asset('/js/ui.js') %>" defer></script>
</body>
</html>
