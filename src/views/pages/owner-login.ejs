<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Log in · <%= businessName %></title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
  <main>
    <header class="top"><p class="brand"><%= businessName %></p></header>
    <h1>Log in</h1>
    <% if (error) { %><p class="notice notice-error" role="alert"><%= error %></p><% } %>
    <form method="post" action="/owner/login">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required autofocus>
      </div>
      <button class="btn" type="submit">Log in</button>
    </form>
  </main>
</body>
</html>
