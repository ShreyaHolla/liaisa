<%- include('../partials/head', { title: 'Log in · ' + businessName }) %>
<body>
  <%- include('../partials/site-bar', { brand: businessName, links: false }) %>
  <main class="container container--narrow">
    <h1>Log in</h1>
    <% if (error) { %><p class="banner tone-problem" role="alert"><%= error %></p><% } %>
    <form method="post" action="/owner/login" class="card">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" maxlength="200" required autofocus>
      </div>
      <button class="btn lg block" type="submit">Log in</button>
    </form>
    <p class="small"><a href="/">← Back to Liaisa</a></p>
  </main>
  <script src="<%= asset('/js/ui.js') %>" defer></script>
</body>
</html>
