<%- include('../partials/head', { title: 'Message to ' + draft.name + ' · ' + businessName }) %>
<%- include('../partials/owner-open', { active: 'clients', businessName: businessName, csrfToken: csrfToken, pending: pending }) %>
<a class="back" href="/owner/clients?tab=<%= draft.subjectType === 'lead' ? 'leads' : 'reconnect' %>">← Clients</a>
<div class="page-head"><h1>Message to <%= draft.name %></h1></div>
<p class="slate">Why now: <%= draft.reason %> · By <%= draft.channel === 'whatsapp' ? 'WhatsApp' : 'email' %></p>
<% if (notice) { %>
  <p class="banner tone-<%= notice[0] === 'ok' ? 'done' : 'problem' %>" role="<%= notice[0] === 'ok' ? 'status' : 'alert' %>"><%= notice[1] %></p>
<% } %>
<p class="slate small" role="note">Check each contact before you send. You are responsible for what you send.</p>
<% var done = ['sent', 'opened', 'sending', 'discarded'].includes(draft.status); %>

<% if (done) { %>
  <p class="banner tone-done" role="status"><%= draft.status === 'opened' ? 'Opened in WhatsApp. Tap Send there to deliver it.' : draft.status === 'sent' ? 'Sent.' : draft.status === 'sending' ? 'Sending…' : 'This draft was discarded.' %></p>
  <blockquote class="draft"><%= draft.message %></blockquote>
<% } else { %>
  <p class="slate small"><% if (draft.source === 'ai') { %><%- include('../partials/ai-badge') %> Written by Liaisa from the facts we hold. Check it before you send.<% } else { %><span class="tag">Standard message</span> This is the standard message. Edit it as you like.<% } %></p>
  <% if (error) { %><p class="banner tone-problem" role="alert"><%= error %></p><% } %>
  <form method="post" action="/owner/clients/drafts/<%= draft.id %>/send" class="card">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="9" maxlength="1000"<%- error ? ' aria-invalid="true"' : '' %>><%= text !== null ? text : draft.message %></textarea>
    </div>
    <p class="slate small"><%= draft.channel === 'whatsapp' ? 'This opens WhatsApp with the message filled in. You tap Send there.' : 'This sends an email from your business mailbox.' %></p>
    <div class="action-bar action-bar--sticky">
      <button class="btn lg" type="submit"
        data-confirm="Send this message to <%= draft.name.split(' ')[0] %> <%= draft.channel === 'whatsapp' ? 'on WhatsApp' : 'by email' %>?"
        data-confirm-label="Approve &amp; send">Approve &amp; send</button>
      <a class="btn secondary" href="/owner/clients?tab=<%= draft.subjectType === 'lead' ? 'leads' : 'reconnect' %>">Back</a>
    </div>
  </form>
<% } %>
<%- include('../partials/owner-close') %>
