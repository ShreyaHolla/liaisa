<dialog id="confirm-dialog" aria-labelledby="confirm-text">
  <form method="dialog">
    <p id="confirm-text"></p>
    <div class="actions">
      <button class="btn" id="confirm-ok" value="ok">Confirm</button>
      <button class="btn secondary" value="cancel">Cancel</button>
    </div>
  </form>
</dialog>
