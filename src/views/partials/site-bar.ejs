<header class="site-bar">
  <div class="site-bar__inner">
    <% if (typeof logo !== 'undefined' && logo) { %>
      <a class="brand brand--logo" href="/"><img src="<%= asset('/img/liaisa-logo.svg') %>" alt="Liaisa" width="85" height="32"></a>
    <% } else { %>
      <a class="brand" href="<%= typeof brandHref !== 'undefined' ? brandHref : '/' %>"><%= brand %></a>
    <% } %>
    <% if (typeof links !== 'undefined' && links) { %>
      <nav aria-label="Main">
        <a href="/#how">How it works</a>
        <a href="/#contact">Contact</a>
        <a href="/signup">Sign up</a>
        <a href="/owner/login">Owner login</a>
      </nav>
    <% } %>
  </div>
</header>
