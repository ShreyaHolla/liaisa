<%
  var nav = ownerNav;
  var badge = typeof pending !== 'undefined' ? pending : 0;
%>
<body class="owner">
<a class="sr" href="#main">Skip to content</a>
<div class="shell">
  <aside class="sidebar" aria-label="Owner">
    <a class="brand brand--mark" href="/owner"><img src="<%= asset('/img/liaisa-mark.svg') %>" alt="" width="28" height="28"><span>Liaisa</span></a>
    <p class="biz-name"><%= businessName %></p>
    <nav aria-label="Owner">
      <% nav.forEach(function (n) { %>
        <a href="<%= n.href %>"<%- active === n.key ? ' aria-current="page"' : '' %>>
          <svg viewBox="0 0 24 24" aria-hidden="true"><%- n.icon %></svg><%= n.label %><% if (n.key === 'approvals' && badge > 0) { %><span class="count" aria-label="<%= badge %> waiting"><%= badge %></span><% } %>
        </a>
      <% }) %>
    </nav>
    <div class="spacer"></div>
    <% if (typeof owner !== 'undefined' && owner) { %><p class="biz-name sidebar__email"><%= owner.email %></p><% } %>
    <form method="post" action="/owner/logout">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn text" type="submit" data-no-busy>Log out</button>
    </form>
  </aside>
  <main class="shell__main" id="main">
    <header class="owner-bar">
      <a class="brand brand--mark" href="/owner"><img src="<%= asset('/img/liaisa-mark.svg') %>" alt="" width="28" height="28"><span>Liaisa</span></a>
      <span class="owner-bar__biz"><%= businessName %></span>
    </header>
    <div class="container">
