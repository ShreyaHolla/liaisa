# Copy this file to .env and fill in real values.
# NEVER commit .env. On GoDaddy hosting, set these as environment variables instead.

# --- App ---
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# --- Database (GoDaddy managed MySQL in production) ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Claude API ---
ANTHROPIC_API_KEY=
AI_ENABLED=true
AI_MODE=mock
AI_MODEL_INTAKE=claude-haiku-5-5
AI_MODEL_RATECARD=claude-haiku-5-5
AI_MODEL_BRIEF=claude-sonnet-5-5
AI_DAILY_REQUEST_CAP=200
CLIENT_FINDER_DAILY_CAP=10
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
AI_PRICE_CACHE_READ_PER_MTOK=
AI_PRICE_CACHE_WRITE_PER_MTOK=

# --- Email (Titan mailbox on liaisa.co.in) ---
# MAIL_ENABLED=true requires SMTP_HOST, SMTP_USER, SMTP_PASS and OWNER_EMAIL; default false.
MAIL_ENABLED=false
# Username is the full email address.
# If login is rejected at smtp.titan.email, try smtpout.secureserver.net.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=hello@liaisa.co.in
SMTP_PASS=
MAIL_FROM=Liaisa <hello@liaisa.co.in>
OWNER_EMAIL=

# --- Owner login ---
# Both or neither: set both to enable /owner; set only one and the app refuses to start.
# Make the hash with `npm run hash-password`. Keep the single quotes: the hash contains $.
OWNER_PASSWORD_HASH=
# At least 32 random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=

# --- WhatsApp click-to-chat ---
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# --- Follow-ups ---
FOLLOWUP_DEMO_MODE=false

# --- Demo data (npm run demo:reset refuses to run unless true) ---
DEMO_RESET_ALLOWED=false
