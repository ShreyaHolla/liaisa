{
  "name": "liaisa",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic liaison for small businesses: finds clients and turns enquiries into owner-approved quotes.",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "build": "echo build",
    "start": "node src/server.js",
    "test": "node scripts/test.js",
    "eval": "node --env-file=.env tests/eval.js",
    "test:pricing": "node --test --experimental-test-coverage --test-coverage-include=src/services/pricing/*.js --test-coverage-branches=100 tests/unit/pricing.test.js",
    "hash-password": "node scripts/hash-password.js",
    "package": "node scripts/package.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "bcryptjs": "^3.0.3",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.6.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
